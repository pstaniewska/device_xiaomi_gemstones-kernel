# Pelikan Kernel Config
# SukiSU + SUSFS + KPM + Manual Hooks

# KernelSU
CONFIG_KSU=y
CONFIG_KPM=y

# SUSFS
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_SU=n

# Disable debug symbols (smaller kernel, faster build)
CONFIG_DEBUG_INFO=n

CONFIG_LOCALVERSION="-pelikan"
